# Môi trường đánh giá RAG (eval). Copy thành `.env.eval`, chạy bằng `task <task> env=eval`.
# Chỉ ghi các biến KHÁC với `.env`; phần còn lại lấy từ `.env`.
# Quy ước tên: unisage-backend/changes/30-09-2026-RAG-Evaluation/spec.md §12.7.
APP_ENV=eval
# DB của backend-java cho env này (khớp application-eval.properties); chỉ `task db:up` dùng để tạo DB.
BACKEND_DB_NAME=assistant_eval
DB_URL=postgresql+asyncpg://postgres:123456@localhost:5433/unisage_agent_eval
MINIO_BUCKET=unisage-eval
QDRANT_COLLECTION=unisage_eval_chunks
# Redis của dev dùng db 0 (app), 1 (Celery broker), 2 (Celery result), 6 (cache web search); eval
# dùng 3/4/5/7 để worker dev không nhận nhầm task của eval.
REDIS_URL=redis://localhost:6379/3
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/5
# Web search result cache on the redis-cache instance, apart from the dev stack's db 0
WEB_SEARCH_CACHE_REDIS_URL=redis://localhost:6380/1
# Retrieval cache: off by default in eval so the harness measures the real pipeline; set
# redis://localhost:6380/3 to measure the cache itself (docs/specs/SPEC-retrieval-cache.md).
RETRIEVAL_CACHE_REDIS_URL=
CELERY_QUEUE_PREFIX=unisage_eval
# evals.ingest: admin account of the eval backend (via the API Gateway)
UNISAGE_GATEWAY_URL=http://localhost:8400
UNISAGE_ADMIN_CODE=SA-001
UNISAGE_ADMIN_PASSWORD=
# evals: folder of the evaluation dataset (gateway repo's dataset/official). Empty = auto-detect
# ../unisage-gateway or ../api-gateway. Example: EVAL_DATASET_DIR=D:\KLTN\Main\api-gateway\dataset\official
EVAL_DATASET_DIR=
# evals.ingest: when the model quota runs out, wait this many minutes and continue (0 = stop;
# re-running the same command later resumes). Override per run: task eval:ingest -- --quota-wait 60
EVAL_QUOTA_WAIT_MINUTES=30
