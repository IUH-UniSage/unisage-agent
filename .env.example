# App settings
APP_NAME=UniSage AI Agent Service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8402

# Internal service-to-service auth: must match the API Gateway's
# INTERNAL_SECRET_KEY (api-gateway's python-ai-agent-route).
INTERNAL_SECRET_KEY=unisage-internal-secret-key-2026

# Database: same physical Postgres server as backend-java (port 5433 on
# host), separate database from Java's assistant_DB - see SPEC-ingestion-resume.md
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5433/unisage_agent_db

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MULTI_REP_LLM_MODEL=gpt-4o-mini
MULTI_REP_QUESTION_COUNT=3

# MinIO (same shared instance as backend-java)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=unisage-documents
MINIO_SECURE=false

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=unisage_chunks

# backend-java integration - Python forwards the caller's Authorization
# header as-is; no separate secret is needed for this call direction.
BACKEND_JAVA_BASE_URL=http://localhost:8080

# Missing-metadata clarification guard (node 02)
CLARIFICATION_MAX_RETRY=2

# Retrieval / rerank (nodes 10/11)
RETRIEVAL_MAX_CHUNKS=8
RERANK_SCORE_THRESHOLD=0.70
