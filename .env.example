# --- APP_: process-level ---
APP_NAME=UniSage AI Agent Service
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8402

# Internal service-to-service auth: must match the API Gateway's
# APP_INTERNAL_SECRET_KEY (api-gateway's python-ai-agent-route).
APP_INTERNAL_SECRET_KEY=unisage-internal-secret-key-2026

# --- DB_: this service's own Postgres database ---
# Same physical Postgres server as backend-java (port 5433 on host),
# separate database from Java's assistant_DB - see SPEC-ingestion-resume.md
DB_URL=postgresql+asyncpg://postgres:123456@localhost:5433/unisage_agent_db

# --- MINIO_: object storage (same shared instance as backend-java) ---
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=unisage-documents
MINIO_SECURE=false

# --- Single-var external systems ---
REDIS_URL=redis://localhost:6379/0

# backend-java integration - Python forwards the caller's Authorization
# header as-is, plus X-Internal-Secret (APP_INTERNAL_SECRET_KEY above). Must
# include Java's context-path (/api/v1 by default).
BACKEND_JAVA_BASE_URL=http://localhost:8401/api/v1

# Slack Incoming Webhook URL for operational alerts. Leave empty to disable.
# SLACK_APIKEY_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx

# --- QDRANT_: vector store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=unisage_chunks

# --- TAVILY_: web search for WebSearchNode (empty key = web search skipped) ---
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
# Comma-separated; only these sites and their subdomains are searched
TAVILY_INCLUDE_DOMAINS=iuh.edu.vn
# basic = 1 credit/search, advanced = 2 credits with longer snippets
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=15

# --- INGEST_: read only at document-ingestion time ---
INGEST_MULTI_REP_QUESTION_COUNT=3
INGEST_SEMANTIC_MAX_TOKEN_FACTOR=1.5
INGEST_TABLE_CHUNK_MAX_TOKENS=800
INGEST_CHUNKING_VERSION=2026-09-structural-v2
# Minimum seconds between the start of two extraction calls in one embed job (0 = no pause).
INGEST_EXTRACTION_MIN_INTERVAL_SECONDS=0
# When every EXTRACTION credential is cooling down: seconds to wait before retrying the chunk.
INGEST_EXTRACTION_CREDENTIAL_WAIT_SECONDS=35
# How many such waits one chunk gets before the embed job fails (0 = never wait).
INGEST_EXTRACTION_MAX_CREDENTIAL_WAITS=6

# --- CHAT_: read on every graph/chat turn ---
# Missing-metadata clarification guard
CHAT_CLARIFICATION_MAX_RETRY=2

# Retrieval / rerank
# RETRIEVAL_MAX_CHUNKS: candidates fetched per turn (split across sub-queries) for
# the rerank to judge. CONTEXT_MAX_CHUNKS: max chunks that reach the answer prompt.
CHAT_RETRIEVAL_MAX_CHUNKS=16
CHAT_CONTEXT_MAX_CHUNKS=8
CHAT_RERANK_SCORE_THRESHOLD=0.70

# Max sub-queries the decomposer may split one comparison question into
CHAT_MAX_SUB_QUERIES=3

# GenerationSynthesisNode's JSON-repair follow-up call - a heuristic can
# false-positive and make the repair call hallucinate an ask_user_form
# nobody asked about (see app/core/config.py). Set to false to disable it.
CHAT_ALLOW_REPAIR_JSON=true

# LLMRerankNode: one call to the EXTRACTION model per turn keeps only the chunks
# that actually answer each sub-query (the score threshold passes keyword-only
# matches). Skipped, with an AI-admin warning, when no EXTRACTION model is set.
CHAT_LLM_RERANK_ENABLED=true
CHAT_LLM_RERANK_SNIPPET_CHARS=800
# When the LLM rerank keeps nothing for any sub-query, each sub-query whose best
# score is >= RESCUE_MIN_SCORE keeps its top RESCUE_KEEP chunks (KEEP=0 disables).
CHAT_LLM_RERANK_RESCUE_MIN_SCORE=0.75
CHAT_LLM_RERANK_RESCUE_KEEP=2

# WebSearchNode: search the web (TAVILY_*) for each sub-query rerank left with
# no chunk, before falling back to TicketFallbackNode. Needs TAVILY_API_KEY.
CHAT_WEB_SEARCH_ENABLED=false
CHAT_WEB_SEARCH_MAX_RESULTS_PER_SUB=5
CHAT_WEB_SEARCH_MAX_RESULTS_PER_TURN=2
CHAT_WEB_SEARCH_MAX_QUERIES=2
CHAT_WEB_SEARCH_MIN_SCORE=0.5
CHAT_WEB_SEARCH_RESULT_MAX_CHARS=1500

# --- Cost tracking & budget ---
# Must match backend-java APP_TIMEZONE: DAILY/MONTHLY budget periods are cut in this zone.
APP_TIMEZONE=Asia/Ho_Chi_Minh
BUDGET_RESERVATION_MULTIPLIER_CHAT=1.5
BUDGET_RESERVATION_FALLBACK_USD=0.05
BUDGET_RESERVATION_TTL_SECONDS=600
BUDGET_SNAPSHOT_REFRESH_SECONDS=60
MODEL_PRICING_SNAPSHOT_REFRESH_SECONDS=60
USAGE_OUTBOX_DRAIN_INTERVAL_SECONDS=5
